{# Helium/Chromium theme generated by wallust — layering mirrors the midnight discord theme #}
{%- set bg3 = background | lighten(0.1) -%}
{%- set bg4 = background | lighten(0.2) -%}
{%- set muted = foreground | darken(0.3) -%}
{
	"manifest_version": 3,
	"name": "Wallust",
	"version": "1.0",
	"description": "Theme generated by wallust",
	"theme": {
		"colors": {
			"frame": [{{ background | rgb }}],
			"frame_inactive": [{{ background | rgb }}],
			"frame_incognito": [{{ background | darken(0.3) | rgb }}],
			"frame_incognito_inactive": [{{ background | darken(0.3) | rgb }}],

			"toolbar": [{{ bg3 | rgb }}],
			"toolbar_button_icon": [{{ foreground | rgb }}],
			"bookmark_text": [{{ foreground | rgb }}],

			"background_tab": [{{ background | rgb }}],
			"background_tab_inactive": [{{ background | rgb }}],
			"tab_text": [{{ foreground | rgb }}],
			"tab_background_text": [{{ muted | rgb }}],
			"tab_background_text_inactive": [{{ muted | rgb }}],
			"tab_background_text_incognito": [{{ muted | rgb }}],
			"tab_background_text_incognito_inactive": [{{ muted | rgb }}],

			"omnibox_background": [{{ bg4 | rgb }}],
			"omnibox_text": [{{ foreground | rgb }}],

			"ntp_background": [{{ bg3 | rgb }}],
			"ntp_text": [{{ foreground | rgb }}],
			"ntp_link": [{{ color2 | rgb }}]
		}
	}
}
